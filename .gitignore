__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
build/
dist/
.pytest_cache/
.coverage
coverage.lcov
coverage.xml
htmlcov/
.DS_Store

# Fetched papers, and the blocks extracted from them. Manifests record provenance,
# but the bytes are the publisher's and every article can be re-fetched from its
# DOI; corpus/*/extracted/ is derived data, rebuilt by
# `python -m manuscript_harvest.extract.cli all`.
corpus/

# Papers fetched by hand from the publisher's site, to check the fetcher against.
# Ignored for the
# same reason corpus/ is -- the bytes are the publisher's. manual_fetch/manual_fetch.yaml is the
# exception and is checked in, because the claims it makes about those bytes are
# the part that gets reviewed. manual-fetch-run/ is the scratch corpus `verify` fetches
# into, kept away from the real one.
manual_fetch/*
!manual_fetch/manual_fetch.yaml
manual-fetch-run/

curation/

# Hand-labelled answers the select stage scores against, and the sheets they come
# from. Ignored to make the boundary in the README mechanical rather than a matter of
# remembering: what counts as an "own deposit" is defined by the question that
# produced the label, so the labels travel with that question and reach `eval`
# through --truth. They also outlive a re-fetch and a parser change, which is the
# opposite of a reviews/ answer -- filing them here would invite the wrong lifecycle.
# The sheet is regenerable with `manuscript-select sheet`.
truth/
accession-labels.html

# Run logs and one-off reports from a fetch, extract or re-extract session.
# They are a record of one afternoon on one machine -- the durable facts land in
# the manifest, the extraction record and `reviews/`. Ignored rather than
# deleted so `git status` stays readable on a repo that gets tagged: an
# untracked file nobody intends to commit is noise that hides one somebody does.
finish-fetch*
oa-direct*
reextract-*.jsonl
reextract-*.log
review-10.*.html
# Slide decks. Derived artifacts: a deck is built FROM
# .claude/skills/perturbation-detection/EXPLAINED.md, which is the version that
# is worth versioning -- it is text, it diffs, and every number in it reconciles
# against the corpus. A 2.5 MB binary that re-renders from it earns nothing in
# git and costs a full copy per revision.
*.pptx
*.potx
# Office lock files, created beside a .pptx while it is open.
~$*
